@startuml sistema_domotico

namespace sistema_domotico {
    abstract class Device {
        - ID : int
        - name : string
        - power : double
        - start_time : int
        - priotity : int
        
        + start() : void
        + stop() : void
        + {abstract} update(time: int) : bool
        + operator<(Device& device) : bool
    }

    class ManualDevice {
        - stop_time : int
        + update(time: int) : bool
    }

    class CycleDevice {
        - cycle_duration : int
        + update(time: int) : bool
    }

    class Home {
        - current_time : int
        - network_power : double
        + subscribe(device: Device) : void
        + get_time() : int
        + start_device(device: Device) : void
        + stop_device(device: Device) : void
        + set_time(time: int) : void
        + set_start(time: int, device: Device) : void
        + set_stop(time: int, device: Device) : void
        + show( ) : void
        + show(device: Device) : void
    }

    class Logger {
        - file : file
        + Logger (log_path: string)
        + log(message: string)
    }
}

namespace std {
    class vector {}
}

Home o-- Logger : home
Logger *-- Home : logger
vector *-- Home : devices
Device o-- vector : array
ManualDevice --|> Device
CycleDevice --|> Device
@enduml